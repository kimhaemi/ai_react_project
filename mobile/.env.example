# 앱이 열 웹 서버 주소 (Next + API 서버, 기본 포트 3200)
#   안드로이드 에뮬레이터: http://10.0.2.2:3200
#   iOS 시뮬레이터:       http://localhost:3200
#   실제 폰(같은 Wi-Fi):  http://<내 PC IP>:3200
#   운영:                 https://admin.example.com
MOBILE_SERVER_URL=http://10.0.2.2:3200

# 앱 고유 ID (스토어 등록 후 변경 불가)
MOBILE_APP_ID=com.example.reacttest
