# =====================================================
# 환경변수 템플릿. 직접 수정하지 말고 `pnpm makeenv` 로 .env 파일을 만드세요.
# (실제 .env 파일은 git 에 올라가지 않습니다)
# =====================================================

# ---------- 서버 (화면 + API 를 같은 포트로 실행) ----------
PORT=3200

# ---------- 프론트 ----------
# API 주소. 같은 서버이므로 기본값은 /api (다른 서버의 API 를 쓸 때만 전체 주소로 변경)
# NEXT_PUBLIC_ 값은 빌드할 때 코드에 들어가므로 바꾸면 다시 빌드해야 함
NEXT_PUBLIC_API_BASE_URL=/api
# API 요청 제한 시간(ms)
NEXT_PUBLIC_API_TIMEOUT=10000

# ---------- API ----------
# 공지사항 저장 파일 (프로젝트 루트 기준)
NOTICE_DATA_FILE=data/notices.json
