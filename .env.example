# =====================================================
# 환경변수 템플릿. 직접 수정하지 말고 `pnpm makeenv` 로 .env 파일을 만드세요.
# (실제 .env 파일은 git 에 올라가지 않습니다)
# =====================================================

# ---------- 서버 (화면 + API 를 같은 포트로 실행) ----------
PORT=3200

# ---------- 프론트 ----------
# API 주소. 같은 서버이므로 기본값은 /api (다른 서버의 API 를 쓸 때만 전체 주소로 변경)
# NEXT_PUBLIC_ 값은 빌드할 때 코드에 들어가므로 바꾸면 다시 빌드해야 함
NEXT_PUBLIC_API_BASE_URL=/api
# API 요청 제한 시간(ms)
NEXT_PUBLIC_API_TIMEOUT=10000
# RealGrid2 라이선스 키. 개발용은 https://service.realgrid.com/start 에서 발급 (도메인 단위, 브라우저에 그대로 노출됨)
# 비워 두면 /components/realgrid 화면에 안내만 표시
NEXT_PUBLIC_REALGRID_LICENSE=
# 카카오맵 JavaScript 키. https://developers.kakao.com > 내 애플리케이션 > 앱 키 (REST API 키 아님)
# 플랫폼 > Web 에 사이트 도메인(예: http://localhost:3200) 등록, 카카오맵 사용 설정 ON 필요. 브라우저에 그대로 노출됨
# 비워 두면 /components/kakao-map 화면에 안내만 표시
NEXT_PUBLIC_KAKAO_MAP_KEY=
# Google Maps API 키. Google Cloud 콘솔 > Maps JavaScript API 사용 설정 > 사용자 인증 정보 (결제 계정 연결 필요)
# HTTP 리퍼러 제한에 사이트 주소(예: http://localhost:3200/*) 등록 권장. 브라우저에 그대로 노출됨. 비우면 안내만 표시
NEXT_PUBLIC_GOOGLE_MAP_KEY=
# Google 고급 마커용 지도 ID (Google Cloud 콘솔 > 지도 관리). 비우면 테스트용 DEMO_MAP_ID 사용
NEXT_PUBLIC_GOOGLE_MAP_ID=
# 네이버 지도 Client ID. 네이버 클라우드 플랫폼 콘솔 > Maps > Application 등록 (Dynamic Map 선택)
# Web 서비스 URL 에 사이트 주소(예: http://localhost:3200) 등록 필요. 브라우저에 그대로 노출됨. 비우면 안내만 표시
NEXT_PUBLIC_NAVER_MAP_KEY=

# ---------- API ----------
# 공지사항 저장 파일 (프로젝트 루트 기준)
NOTICE_DATA_FILE=data/notices.json

# ---------- 파일 업로드 ----------
# 업로드 파일 저장 폴더 (프로젝트 루트 기준)
UPLOAD_DIR=uploads
# 파일 1개 최대 크기(MB)
UPLOAD_MAX_SIZE_MB=10
# 한 번에 올릴 수 있는 파일 수
UPLOAD_MAX_FILES=10
